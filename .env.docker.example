# Módulo: Plantilla de variables para el despliegue con Docker Compose (sin valores reales)
# Proyecto: Turnia
# Autor: Ronald
# Fecha de creación: 08/10/2026
#
# Uso: cp .env.docker.example .env   (en la raíz del proyecto, junto a docker-compose.yml)
# El archivo .env resultante NO se sube al repositorio (está en .gitignore).
# Evita el carácter $ en los valores: Docker Compose lo interpreta como variable.

# ---------- Base de datos (contenedor "db", PostgreSQL 16) ----------
# Usuario, contraseña y nombre de la base que crea el contenedor la primera vez.
# OBLIGATORIO cambiar PG_CLAVE. Usa solo letras y números: la clave va dentro de
# DATABASE_URL y los símbolos como @ : / # ? romperían la URL.
# Genera una con:  openssl rand -hex 16
# Ojo: estos valores solo se aplican al crear el volumen por primera vez; si luego los
# cambias, la base existente conserva los anteriores (ver DESPLIEGUE.md).
PG_USUARIO=turnia_app
PG_CLAVE=
PG_BD=turnia

# ---------- Autenticación ----------
# Secreto para firmar los tokens JWT. OBLIGATORIO: sin él, docker compose se detiene
# con un mensaje de error. Genera uno con:  openssl rand -hex 48
JWT_SECRET=
# Duración de la sesión (formato de jsonwebtoken: 7d, 12h, 30m...).
JWT_EXPIRACION=7d

# ---------- Servidor ----------
# Origen permitido para CORS. En este despliegue el frontend y la API comparten origen
# (Nginx sirve ambos en https://<servidor>/), así que el navegador no usa CORS y este
# valor no bloquea nada; la API solo exige que exista. Recomendado: la dirección con la
# que se abre el sitio, por ejemplo https://turnia.local o https://192.168.1.50
ORIGEN_PERMITIDO=https://turnia.local
# Nombre (o IP) que se escribe en el certificado autofirmado generado la primera vez.
# Si lo cambias después, borra el certificado del volumen para que se regenere.
NOMBRE_SERVIDOR=turnia.local

# ---------- Cuentas que crea la semilla ----------
# Solo se crean si no existen. Cambia las contraseñas antes de usarlo con clientas reales.
CORREO_ADMIN=admin@turnia.gt
CONTRASENA_ADMIN=Admin1234Dev!
CORREO_CLIENTA=clienta@turnia.gt
CONTRASENA_CLIENTA=Clienta1234Dev!

# ---------- Correo (SMTP), opcional ----------
# Vacías = modo consola: los correos se imprimen en  docker compose logs api
# Para Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=587 y una contraseña de aplicación.
SMTP_HOST=
SMTP_PUERTO=
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
