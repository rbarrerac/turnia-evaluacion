# Base de datos — rol dedicado de la aplicación (no el superusuario de Postgres)
DATABASE_URL="postgresql://turnia_app:cambia-esta-clave-app@localhost:5432/turnia"

# Superusuario de PostgreSQL — solo lo usan los scripts de preparación de la base
# de datos (npm run preparar-bd / reiniciar-bd) para crear el rol, la base y la
# extensión btree_gist. Nunca se usa para las conexiones normales de la API.
PG_SUPERUSUARIO="postgres"
PG_SUPERCLAVE="cambia-esta-clave-superusuario"
PG_HOST="localhost"
PG_PUERTO="5432"

# Autenticación
JWT_SECRET="cadena-larga-aleatoria-cambiar-en-produccion"
JWT_EXPIRACION="7d"

# Servidor de correo (SMTP). Opcional. Déjalas vacías para modo consola (los
# correos se imprimen en la terminal). Complétalas solo para enviar correo real.
SMTP_HOST=
SMTP_PUERTO=
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=

# Servidor
PUERTO_API="4000"
ORIGEN_PERMITIDO="http://localhost:5173"

# Almacenamiento de archivos subidos (galería de trabajos, Incremento 6).
# Opcional: si se omite, se usa "almacenamiento/trabajos" dentro de api/.
DIRECTORIO_SUBIDAS="almacenamiento/trabajos"

# Semilla (usada solo por prisma/semilla.js)
# Correo de la usuaria administradora sembrada; si se omite se usa admin@turnia.gt
CORREO_ADMIN="admin@turnia.gt"
# Contraseña de la usuaria administradora sembrada; si se omite se usa una clave
# de desarrollo temporal y se imprime una advertencia. Definirla siempre en producción.
CONTRASENA_ADMIN="Admin1234Dev!"
# Correo de la usuaria clienta de prueba sembrada; si se omite se usa clienta@turnia.gt
CORREO_CLIENTA="clienta@turnia.gt"
# Contraseña de la clienta de prueba sembrada; mismo comportamiento por defecto
# que CONTRASENA_ADMIN si se omite.
CONTRASENA_CLIENTA="Clienta1234Dev!"
