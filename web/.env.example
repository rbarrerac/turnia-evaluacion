# Módulo: Plantilla de variables de entorno del frontend (desarrollo)
# Proyecto: Turnia
# Modificado por: Luis — 08/10/2026 (Incremento 8: VITE_URL_API vacía en el despliegue con Docker)

# URL base de la API de Turnia (leída por src/api/clienteApi.js)
# - Desarrollo local: la URL completa de la API (copia este archivo a web/.env).
# - Despliegue con Docker: se construye con VITE_URL_API vacía; el frontend y la API
#   comparten origen detrás de Nginx y las peticiones van a rutas relativas (/api/...).
VITE_URL_API="http://localhost:4000/api"
