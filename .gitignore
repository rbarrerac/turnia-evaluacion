ARQUITECTURA.md

# Dependencias
node_modules/

# Variables de entorno (contienen secretos)
.env
.env.local

# Compilados / builds
dist/
build/

# Prisma
api/prisma/migrations/dev/

# Almacenamiento local de fotos de la galería de trabajos (Incremento 6):
# se conserva la carpeta (con .gitkeep) pero no su contenido subido.
api/almacenamiento/trabajos/*
!api/almacenamiento/trabajos/.gitkeep

# Archivos del sistema
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Cobertura de pruebas
coverage/

# Registros de disponibilidad (RNF-04) generados en la Raspberry Pi (Incremento 8)
registros/

